{
  "name": "@mingworkbench/capability-pack",
  "version": "0.4.0",
  "description": "Ming 智能助手 - 用自然语言一键调用 Harness 原生能力，真正完成任务并产出文件",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bin/ming.js": "./bin/ming.js"
  },
  "bin": {
    "ming": "./bin/ming.js",
    "ming.cmd": "./bin/ming.cmd"
  },
  "files": [
    "dist",
    "bin",
    "scripts",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "capabilities",
    "automation",
    "ai-assistant"
  ],
  "author": "Ming Workbench",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YuemingHub/Ming-Capability-Pack.git"
  },
  "bugs": {
    "url": "https://github.com/YuemingHub/Ming-Capability-Pack/issues"
  },
  "homepage": "https://github.com/YuemingHub/Ming-Capability-Pack#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.0",
    "tsup": "^8.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.js",
    "cli": "node bin/ming.js",
    "prepublishOnly": "npm run build"
  }
}
